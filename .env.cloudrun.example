# ==============================================================
# Variables de entorno para Google Cloud Run + Supabase (MMOM)
# ==============================================================

APP_NAME="Simulador MMOM"
APP_ENV=production
APP_KEY=base64:COPIA_AQUI_LA_KEY_GENERADA_O_USA_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://tu-servicio-cloud-run.a.run.app

# Logging: stderr envía los logs directamente a Google Cloud Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ==============================================================
# Conexión a Base de Datos Supabase (PostgreSQL)
# ==============================================================
DB_CONNECTION=pgsql

# OPCIÓN 1 (Recomendada): Usar los parámetros individuales de Supabase
# Puedes obtener estos valores en tu panel de Supabase -> Project Settings -> Database
DB_HOST=db.TU_PROYECTO_REF.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=TU_CONTRASENA_DE_SUPABASE
DB_SSLMODE=require

# (Si usas el Connection Pooler de Supabase en vez de conexión directa):
# DB_HOST=aws-0-TU_REGION.pooler.supabase.com
# DB_PORT=6543
# DB_USERNAME=postgres.TU_PROYECTO_REF

# OPCIÓN 2: Usar la URI completa proporcionada por Supabase
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require"

# ==============================================================
# Opciones de Ejecución
# ==============================================================
# Si es true, el contenedor ejecutará "php artisan migrate --force" al iniciar
RUN_MIGRATIONS=true

# Sesiones y Caché en Base de Datos
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
